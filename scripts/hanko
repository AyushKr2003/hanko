#!/bin/bash
# hanko · install Hanko into Omarchy and change its style from a terminal.
#
#   hanko install [--desk]   copy this checkout into the plugins folder and use it;
#                            --desk also turns on Kaze, the whole desk (desk on)
#   hanko dev [--desk]       symlink this checkout instead (edits reload live)
#   hanko uninstall          go back to the bar you had before, remove Hanko
#   hanko settings           open (or close) the settings window
#   hanko style get          print the resolved style
#   hanko style doc          print style.json as Hanko reads it
#   hanko style set K V      change one setting (e.g. clock mono)
#   hanko style set --monitor NAME K V
#                            change it on one monitor only (e.g. DP-2 height 32)
#   hanko style preset NAME  Quiet | Islet | Shoji | Kamon | Inkan | Ma | Shizuka | Suji
#                            | Inro
#   hanko inkan [on|off]     the seal only (form inkan) or the bar again; toggles
#                            with no argument
#   hanko style reset        back to the preset, edits dropped
#   hanko style shuffle      a random combination
#   hanko hide PART          take one part off the bar (e.g. tray, volume,
#                            indicator:night, tray:nm-applet, hosted:omarchy.weather)
#   hanko show PART          put it back
#   hanko press              press the seal: print No. 00 (every sheet on one),
#                            or lift it off (bind it to a key: see the README)
#   hanko menu add|remove    put Hanko under Setup in the Omarchy menu
#   hanko cursor [on|off]    the brush-tip cursor (Hanko-Brush) in the theme's ink;
#                            off puts your own cursor back
#   hanko cursor size N      its size in pixels (16-48; turns it on if it's off)
#   hanko sumi [on|off]      Sumi 墨: the whole screen in ink, letters held, the
#                            wind stronger; toggles with no argument
#   hanko theme on|off|install|remove|status  the Hanko theme (theme/) linked
#                            into ~/.config/omarchy/themes/hanko; on also sets
#                            it, off goes back to the theme it replaced
#   hanko boot on|off|refresh|preview|status  Ōin 押印: the boot and disk-unlock
#                            screen (Plymouth) in the theme's paper and inks;
#                            off goes back to Omarchy's (needs root, rebuilds
#                            the initramfs); refresh redraws it after a theme
#                            change
#   hanko tools on|off|status Dōgu 道具: btop and Neovim in the theme's inks
#                            (btop's color_theme and a LazyVim spec; off puts
#                            Omarchy's back)
#   hanko desk on|off|status Kaze 風: the desk's plugins (the focus sweep, the
#                            print and grass, the OSD, letters, the menu, the
#                            lock; any bar). Run `desk on` again after an update
#                            to refresh them. It never edits your Hyprland
#                            config: style.lua (windows, motion) loads only from
#                            a line you add to looknfeel.lua (see the README).
#   hanko desk ensure        bring the desk back if it is on but not running
#                            (a post-boot hook runs this after every boot)
#   hanko doctor             check the installation
#
# Style commands talk to the running shell over IPC (omarchy-shell hanko ...),
# so a change shows on the bar at once and is saved to ~/.config/hanko/style.json.

set -euo pipefail

ID="hanko.bar"
SRC="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PLUGINS="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
DEST="$PLUGINS/$ID"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/hanko"
PREVIOUS="$STATE/previous-bar"

say() { printf '%s\n' "$*"; }
fail() { printf 'hanko: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || fail "$1 is required but not installed"; }

shell_up() { omarchy-shell -q shell ping >/dev/null 2>&1; }

ipc() {
  need omarchy-shell
  shell_up || fail "the Omarchy shell is not running"
  omarchy-shell hanko "$@"
}

active_bar() {
  # Not -q: that prints nothing, even what the call returns.
  local id
  id="$(omarchy-shell shell listShellConfig 2>/dev/null | jq -r '.bar.id // "omarchy.bar"' 2>/dev/null || true)"
  printf '%s\n' "${id:-omarchy.bar}"
}

remember_previous() {
  mkdir -p "$STATE"
  local current
  current="$(active_bar)"
  # Never remember Hanko itself, or uninstall would put Hanko back.
  if [[ $current != "$ID" && -z $(cat "$PREVIOUS" 2>/dev/null) ]]; then
    printf '%s\n' "$current" > "$PREVIOUS"
  fi
}

activate() {
  omarchy-shell -q shell rescanPlugins >/dev/null 2>&1 || true
  omarchy bar use "$ID"
  # A running shell's plugin reload keeps the Hanko it already loaded (the
  # QML engine holds on to its types and singletons), so an update only
  # shows after a restart.
  if pgrep -f 'quickshell.*omarchy/shell' >/dev/null 2>&1 && command -v omarchy-restart-shell >/dev/null 2>&1; then
    say "Restarting the Omarchy shell to load this Hanko."
    omarchy-restart-shell >/dev/null 2>&1 || true
  fi
}

cmd_install() {
  need omarchy
  need rsync
  omarchy plugin validate "$SRC" || fail "manifest did not validate"
  remember_previous
  if [[ -L $DEST ]]; then rm "$DEST"; fi
  mkdir -p "$DEST"
  # The plugin needs its QML, scripts and fonts; the design docs and test
  # harness stay in the checkout.
  rsync -a --delete \
    --exclude .git --exclude docs --exclude tests --exclude CLAUDE.md --exclude '*.png' --exclude '*.webp' \
    "$SRC/" "$DEST/"
  activate
  say "Hanko is installed at $DEST and is now your bar."
  if [[ ${1:-} == --desk ]]; then cmd_desk on; fi
}

cmd_dev() {
  need omarchy
  omarchy plugin validate "$SRC" || fail "manifest did not validate"
  remember_previous
  if [[ -e $DEST && ! -L $DEST ]]; then
    fail "$DEST already exists and is not a symlink; run 'hanko uninstall' first"
  fi
  mkdir -p "$PLUGINS"
  ln -sfn "$SRC" "$DEST"
  activate
  say "Hanko is linked from $SRC. Saving a file reloads the bar."
  if [[ ${1:-} == --desk ]]; then cmd_desk on; fi
}

cmd_uninstall() {
  need omarchy
  local previous="omarchy.bar"
  [[ -f $PREVIOUS ]] && previous="$(cat "$PREVIOUS")"
  [[ -n $previous ]] || previous="omarchy.bar"
  omarchy bar use "$previous" 2>/dev/null || omarchy bar use omarchy.bar
  if [[ -L $DEST ]]; then
    rm "$DEST"
  elif [[ -d $DEST ]]; then
    rm -rf "$DEST"
  fi
  rm -f "$PREVIOUS"
  if desk_on || desk_plugins_present; then cmd_desk off; fi
  [[ -f $CURSOR_FLAG ]] && cmd_cursor off
  if tools_on; then cmd_tools off; fi
  if [[ -L $THEME_LINK ]]; then cmd_theme remove; fi
  if boot_on; then cmd_boot off; fi
  omarchy-shell -q shell rescanPlugins >/dev/null 2>&1 || true
  say "Back to $previous. Your Hanko style is kept in ${XDG_CONFIG_HOME:-$HOME/.config}/hanko/."
}

cmd_style() {
  local sub="${1:-get}"
  (( $# > 0 )) && shift || true
  case "$sub" in
    get)
      need jq
      ipc styleGet | jq -r 'to_entries[] | "\(.key)\t\(.value)"' | column -t -s $'\t'
      ;;
    doc) ipc styleDoc ;;
    set)
      if [[ ${1:-} == --monitor ]]; then
        (( $# == 4 )) || fail "usage: hanko style set --monitor <name> <setting> <value>"
        [[ $(ipc styleSetFor "$2" "$3" "$4") == ok ]] || fail "$3 does not take '$4' (see docs/COMPONENTS.md)"
      else
        (( $# == 2 )) || fail "usage: hanko style set [--monitor <name>] <setting> <value>"
        [[ $(ipc styleSet "$1" "$2") == ok ]] || fail "$1 does not take '$2' (see docs/COMPONENTS.md)"
      fi
      ;;
    preset)
      (( $# == 1 )) || fail "usage: hanko style preset <name>"
      [[ $(ipc stylePreset "$1") == ok ]] || fail "unknown preset '$1'"
      ;;
    reset) ipc styleReset >/dev/null ;;
    shuffle) ipc styleShuffle >/dev/null ;;
    *) fail "unknown style command '$sub'" ;;
  esac
}


# Omarchy reads menu additions from ~/.config/omarchy/extensions/omarchy-menu.jsonc
# (a JSONC object of entries). Hanko's entry is one line carrying a marker,
# put right after the opening brace so it never depends on the entry before
# it having a trailing comma; remove deletes exactly that line.
MENU_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/extensions/omarchy-menu.jsonc"
MENU_LINE='  "setup.hanko": {"icon":"鑑","label":"Hanko","action":"omarchy-shell hanko settings"}, // hanko.bar'

cmd_menu() {
  case "${1:-}" in
    add)
      mkdir -p "$(dirname "$MENU_FILE")"
      [[ -s $MENU_FILE ]] || printf '{\n}\n' > "$MENU_FILE"
      if grep -qF "$MENU_LINE" "$MENU_FILE"; then say "Hanko is already in the menu."; return; fi
      # An older entry (the 印 icon before 鑑): swap it for this one in place.
      if grep -q '// hanko.bar$' "$MENU_FILE"; then
        cp "$MENU_FILE" "$MENU_FILE.bak"
        awk -v line="$MENU_LINE" '/\/\/ hanko\.bar$/ { print line; next } { print }' "$MENU_FILE.bak" > "$MENU_FILE"
        say "Updated Setup › Hanko in the Omarchy menu ($MENU_FILE; the old file is at .bak)."
        return
      fi
      grep -q '^[[:space:]]*{' "$MENU_FILE" || fail "$MENU_FILE has no opening brace; add the entry by hand"
      cp "$MENU_FILE" "$MENU_FILE.bak"
      awk -v line="$MENU_LINE" '!done && /^[[:space:]]*\{/ { print; print line; done = 1; next } { print }' "$MENU_FILE.bak" > "$MENU_FILE"
      say "Added Setup › Hanko to the Omarchy menu ($MENU_FILE; the old file is at .bak)."
      ;;
    remove)
      [[ -f $MENU_FILE ]] && grep -q '// hanko.bar$' "$MENU_FILE" || { say "Hanko is not in the menu."; return; }
      cp "$MENU_FILE" "$MENU_FILE.bak"
      grep -v '// hanko.bar$' "$MENU_FILE.bak" > "$MENU_FILE"
      say "Removed Hanko from the Omarchy menu."
      ;;
    *) fail "usage: hanko menu add|remove" ;;
  esac
}

# Kaze 風, the whole desk (docs/kaze). The desk is its plugins; whether it
# is on is one file in the state folder, so it survives a reboot and the
# Settings page can watch it. Hyprland's look (windows, motion) is style.lua,
# which `hanko desk` never wires in: add the pcall line to looknfeel.lua
# yourself when you want it.
DESK_FLAG="$STATE/desk"
LOOK_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/looknfeel.lua"
LOOK_LINE='pcall(dofile, os.getenv("HOME") .. "/.config/omarchy/plugins/hanko.bar/style.lua")'

# On while the flag is there (or the line an older `desk on` added, until
# the next `desk on` or `desk off` trades it for the flag).
desk_on() { [[ -f $DESK_FLAG ]] || { [[ -f $LOOK_FILE ]] && grep -q -- '-- hanko desk$' "$LOOK_FILE"; }; }

# Whether looknfeel.lua loads style.lua on a line that isn't a comment.
style_loaded() { [[ -f $LOOK_FILE ]] && grep -Eq '^[^-]*hanko\.bar/style\.lua' "$LOOK_FILE"; }

# Before the flag, `desk on` appended a line ending `-- hanko desk` to
# looknfeel.lua. It was ours, so it goes; a line of your own stays.
look_legacy_off() {
  [[ -f $LOOK_FILE ]] && grep -q -- '-- hanko desk$' "$LOOK_FILE" || return 1
  local text
  # The blank line it put before its comment goes too; everything else is
  # kept byte for byte (the x keeps $(...) from eating trailing newlines).
  text="$(awk '
    /-- hanko desk$/ { next }
    /^-- Kaze 風: Hanko.s look and motion/ { held = 0; next }
    held { print ""; held = 0 }
    /^$/ { held = 1; next }
    { print }
    END { if (held) print "" }' "$LOOK_FILE"; printf x)"
  # Written through the file, so a looknfeel.lua that is a symlink stays one.
  printf '%s' "${text%x}" > "$LOOK_FILE"
  say "Took out the line an older 'hanko desk on' added to $LOOK_FILE."
  return 0
}

look_hint() {
  style_loaded && return
  say "Windows keep your own look'n'feel. For Hanko's frames and motion, add this to $LOOK_FILE:"
  say "  $LOOK_LINE"
}

hypr_reload() { command -v hyprctl >/dev/null 2>&1 && hyprctl reload >/dev/null 2>&1 || true; }

# Kaze's surfaces are plugins of their own under plugins/ (hanko.desk: the
# focus sweep and urgent frames; hanko.background: the printed wallpaper, a
# clone of omarchy.background; hanko.osd: posture, a clone of omarchy.osd;
# hanko.notifications: letters; hanko.menu: the draw, a clone of omarchy.menu;
# hanko.lock: the standoff, a clone of omarchy.lock with only its view new),
# all sharing Hanko's core/ and its fonts. Omarchy allows no
# symlinks inside a plugin, so each is assembled as a copy: its own files,
# core/, assets/fonts and bin/hanko-print. `desk build ID DIR` does only that (the tests
# validate and lint the result).
SURFACES=(hanko.desk hanko.background hanko.osd hanko.notifications hanko.menu hanko.lock)

# Omarchy's notification daemon: stable's, or the deck (rc, edge, dev:
# Store.js, live.json + history.json) when the installed one has Store.js.
STOCK_NOTIFICATIONS="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/notifications"
deck_daemon() { [[ -f $STOCK_NOTIFICATIONS/Store.js && -f $STOCK_NOTIFICATIONS/Service.qml ]]; }

# Prints the files it changed (rsync's itemized list), nothing when up to date.
surface_build() {
  local id="$1" dest="$2" tmp="" how=(-a)
  local from="$SRC/plugins/$id"
  need rsync
  [[ -d $SRC/plugins/$id ]] || fail "no such surface: $id"
  # Fumi on the deck: a fresh copy of the installed daemon with Hanko's
  # surface (scripts/hanko-fumi-deck); if that refuses, the stable clone,
  # which runs on the deck too. Compared by content without times, as the
  # copy is new each time.
  if [[ $id == hanko.notifications ]] && deck_daemon; then
    tmp="$(mktemp -d)"
    if python3 "$SRC/scripts/hanko-fumi-deck" "$STOCK_NOTIFICATIONS" "$SRC/plugins/$id" "$tmp" >&2; then
      from="$tmp"; how=(-rlpD --checksum)
    else
      say "  (Fumi: Omarchy's newer notification daemon could not be patched; using the stable one)" >&2
    fi
  fi
  mkdir -p "$dest/bin"
  rsync "${how[@]}" --delete --itemize-changes --exclude core --exclude bin --exclude assets --exclude deck "$from/" "$dest/"
  [[ -n $tmp ]] && rm -rf "$tmp"
  rsync -a --delete --itemize-changes "$SRC/core/" "$dest/core/"
  mkdir -p "$dest/assets"
  rsync -a --delete --itemize-changes "$SRC/assets/fonts/" "$dest/assets/fonts/"
  rsync -a --delete --itemize-changes "$SRC/assets/sounds/" "$dest/assets/sounds/"
  rsync -a --delete --itemize-changes --include '*.qsb' --exclude '*' "$SRC/assets/shaders/" "$dest/assets/shaders/"
  rsync -a --itemize-changes "$SRC/scripts/hanko-print" "$dest/bin/hanko-print"
}

# The rescan finishes after its call returns, so a surface just copied in
# can still be unknown to the shell (the first one usually is): ask again
# until it is known, for up to five seconds.
surface_enable() {
  local tries out
  for (( tries = 0; tries < 20; tries++ )); do
    out="$(omarchy plugin enable "$1" 2>&1)" && return 0
    [[ $out == *"is not known"* ]] || break
    sleep 0.25
    omarchy-shell -q shell rescanPlugins >/dev/null 2>&1 || true
  done
  say "  ($1 could not be enabled: ${out##*: })"
}

# Omarchy reloads a plugin when its files change, but a service keeps the
# QML it first compiled until the shell restarts; so when a surface is new
# or gets new files, the shell is restarted once (a second without a bar).
# `desk_plugins_on changed`: the caller already rebuilt the surfaces (desk
# ensure), so this pass finds nothing new but must still restart.
desk_plugins_on() {
  local id dest changed="${1:-}" new=0
  for id in "${SURFACES[@]}"; do
    dest="$PLUGINS/$id"
    [[ -d $dest ]] || new=1
    changed+="$(surface_build "$id" "$dest")"
    omarchy plugin validate "$dest" >/dev/null || fail "$id did not validate"
  done
  omarchy-shell -q shell rescanPlugins >/dev/null 2>&1 || true
  for id in "${SURFACES[@]}"; do surface_enable "$id"; done
  if { (( new )) || [[ -n $changed ]]; } && command -v omarchy-restart-shell >/dev/null 2>&1; then
    say "Kaze's plugins changed: restarting the Omarchy shell to load them."
    omarchy-restart-shell >/dev/null 2>&1 || true
    desk_plugins_check || true
  fi
}

# Each surface answers one IPC call once it is up. A surface that replaced
# an Omarchy one (notifications, the OSD, the background) and didn't come up
# would leave the desk without it, so it is handed back at once.
surface_probe() {
  case "$1" in
    hanko.desk) omarchy-shell hankodesk state ;;
    hanko.background) omarchy-shell hankowind state ;;
    hanko.osd) omarchy-shell osd ping ;;
    hanko.notifications) omarchy-shell notifications ping ;;
    hanko.menu) omarchy-shell shell call omarchy.menu ping "" | grep -x ok ;;
    hanko.lock) omarchy-shell lock status ;;
  esac
}
desk_plugins_check() {
  local id tries failed=()
  for (( tries = 0; tries < 40; tries++ )); do shell_up && break; sleep 0.25; done
  sleep 1.5
  for id in "${SURFACES[@]}"; do
    local ok=0
    for (( tries = 0; tries < 12; tries++ )); do
      [[ -n $(surface_probe "$id" 2>/dev/null | grep -v '^Target not found') ]] && { ok=1; break; }
      sleep 0.5
    done
    (( ok )) || failed+=("$id")
  done
  (( ${#failed[@]} == 0 )) && return 0
  say "These didn't start, so Omarchy's own are back in their place: ${failed[*]}"
  say "  (the shell's log says why: qs log --id \$(qs list --all | grep -oP 'Instance \\K\\w+' | head -1) | grep 'load failed')"
  for id in "${failed[@]}"; do
    omarchy plugin remove "$id" --yes >/dev/null 2>&1 || { omarchy plugin disable "$id" >/dev/null 2>&1 || true; rm -rf "${PLUGINS:?}/$id"; }
  done
  omarchy-shell -q shell rescanPlugins >/dev/null 2>&1 || true
  omarchy-restart-shell >/dev/null 2>&1 || true
  return 1
}
# Removing a clone hands its job back to the Omarchy plugin it came from.
desk_plugins_off() {
  local id
  for id in "${SURFACES[@]}"; do
    [[ -d $PLUGINS/$id ]] || continue
    omarchy plugin remove "$id" --yes >/dev/null 2>&1 || { omarchy plugin disable "$id" >/dev/null 2>&1 || true; rm -rf "${PLUGINS:?}/$id"; }
  done
  # `plugin remove` keeps a .ID.bak.* copy; ours are only rebuilt copies of
  # this checkout, so they don't pile up.
  for id in "${SURFACES[@]}"; do rm -rf "${PLUGINS:?}/.$id.bak."*; done
  omarchy-shell -q shell rescanPlugins >/dev/null 2>&1 || true
}
# Battō 抜刀: the menu in Kaze's grammar through the user-level shell.toml
# (scripts/hanko-kaze-theme), refreshed by a theme-set hook on every theme.
KAZE_HOOK="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/hooks/theme-set.d/50-hanko-kaze"
# Shiki 式: two more hooks call the OSD's ceremonies: 危 when the battery is
# low (Omarchy's battery service runs the battery-low hooks), 新 after an update.
KAZE_BATTERY_HOOK="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/hooks/battery-low.d/50-hanko-kaze"
KAZE_UPDATE_HOOK="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/hooks/post-update.d/50-hanko-kaze"
# After every boot Omarchy runs the post-boot hooks; this one puts the desk
# back if the shell came up without it.
KAZE_BOOT_HOOK="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/hooks/post-boot.d/50-hanko-desk"
write_hook() {
  mkdir -p "$(dirname "$1")"
  printf '#!/bin/bash\n# Kaze 風 (hanko desk off removes this).\n%s\n' "$2" > "$1"
  chmod +x "$1"
}
desk_theme_on() {
  "$SRC/scripts/hanko-kaze-theme" || say "  (the menu keeps its theme's look: no colors.toml found)"
  write_hook "$KAZE_HOOK" "\"$SRC/scripts/hanko-kaze-theme\"
# the brush-tip cursor, when it is on, in the new theme's ink
if [[ -f \"$CURSOR_FLAG\" ]]; then \"$SRC/scripts/hanko-cursor\" >/dev/null && hyprctl setcursor Hanko-Brush \"\$(cat \"$CURSOR_FLAG\")\" >/dev/null; fi"
  write_hook "$KAZE_BATTERY_HOOK" 'omarchy-osd -i danger -m "Battery ${1:-}%" -d 1600 >/dev/null 2>&1 || true'
  write_hook "$KAZE_UPDATE_HOOK" 'omarchy-osd -i new -m "Omarchy $(omarchy version 2>/dev/null | head -1)" -d 1400 >/dev/null 2>&1 || true'
  write_hook "$KAZE_BOOT_HOOK" "mkdir -p \"$STATE\"; \"$SRC/scripts/hanko\" desk ensure >\"$STATE/desk-boot.log\" 2>&1 || true"
}
desk_theme_off() {
  "$SRC/scripts/hanko-kaze-theme" --remove || true
  rm -f "$KAZE_HOOK" "$KAZE_BATTERY_HOOK" "$KAZE_UPDATE_HOOK" "$KAZE_BOOT_HOOK"
}

desk_plugins_present() { local id; [[ -f $KAZE_HOOK || -f $KAZE_BOOT_HOOK ]] && return 0; for id in "${SURFACES[@]}"; do [[ -d $PLUGINS/$id ]] && return 0; done; return 1; }

# Enabled in the shell (its listPlugins), by id, one per line.
enabled_plugins() { omarchy-shell shell listPlugins 2>/dev/null | jq -r '.[] | select(.enabled) | .id' 2>/dev/null || true; }

# The desk is on but the shell may have come up without it (a reboot, an
# update, a bar switch that gave a surface back to Omarchy): put back what is
# missing, quietly when nothing is. Never removes anything.
desk_ensure() {
  desk_on || return 0
  need omarchy
  local id tries changed="" new=0 enabled missing=()
  # At boot the shell can take a while to answer.
  for (( tries = 0; tries < 120; tries++ )); do shell_up && break; sleep 0.5; done
  shell_up || fail "the Omarchy shell is not running"
  for id in "${SURFACES[@]}"; do
    [[ -d $PLUGINS/$id ]] || new=1
    changed+="$(surface_build "$id" "$PLUGINS/$id")"
  done
  if (( new )) || [[ -n $changed ]]; then
    say "Kaze's plugins were missing or out of date: putting them back."
    desk_plugins_on changed
    return
  fi
  enabled="$(enabled_plugins)"
  for id in "${SURFACES[@]}"; do
    grep -qx -- "$id" <<<"$enabled" || missing+=("$id")
  done
  (( ${#missing[@]} )) || { say "Kaze is on and running."; return 0; }
  say "Turning back on: ${missing[*]}"
  omarchy-shell -q shell rescanPlugins >/dev/null 2>&1 || true
  for id in "${missing[@]}"; do surface_enable "$id"; done
  # A service enabled on a running shell mounts at once; a clone that took
  # over from Omarchy's own needs the restart to load cleanly.
  if command -v omarchy-restart-shell >/dev/null 2>&1; then
    omarchy-restart-shell >/dev/null 2>&1 || true
    desk_plugins_check || true
  fi
}

cmd_desk() {
  case "${1:-status}" in
    on)
      need omarchy
      mkdir -p "$STATE"
      desk_plugins_on
      desk_theme_on
      printf 'on\n' > "$DESK_FLAG"
      look_legacy_off && hypr_reload
      say "Kaze is on: the focus sweep, the print and grass, the OSD, letters, the menu and the lock."
      look_hint
      ;;
    off)
      rm -f "$DESK_FLAG"
      desk_plugins_off
      desk_theme_off
      look_legacy_off && hypr_reload
      say "Kaze is off: Omarchy's own background, OSD, notifications, menu and lock are back."
      ;;
    ensure) desk_ensure ;;
    status) if desk_on; then say "on"; else say "off"; fi ;;
    build) [[ -n ${2:-} && -n ${3:-} ]] || fail "usage: hanko desk build ID DIR"; surface_build "$2" "$3" >/dev/null ;;
    *) fail "usage: hanko desk on|off|status|ensure" ;;
  esac
}

# Sumi 墨, ink only (docs/kaze, mockup 11). The shader goes to the state
# folder with the theme's red baked in (that red survives the ink); style.lua
# applies it on every reload while it is there. Do-not-disturb holds the
# letters, and is put back as it was; hanko.background's wind reads the same
# folder and blows harder.
SUMI_DIR="$STATE/sumi"
sumi_on() { [[ -f $SUMI_DIR/sumi.glsl ]]; }
cmd_sumi() {
  local want="${1:-toggle}"
  [[ $want == toggle ]] && { sumi_on && want=off || want=on; }
  case "$want" in
    on)
      local colors red r g b
      colors="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml"
      red="$(grep -m1 -E '^\s*red\s*=' "$colors" 2>/dev/null | sed -E 's/.*"#([0-9a-fA-F]{6})".*/\1/')"
      [[ $red =~ ^[0-9a-fA-F]{6}$ ]] || red="d8452f"
      r=$(awk -v n=$((16#${red:0:2})) 'BEGIN { printf "%.3f", n / 255 }')
      g=$(awk -v n=$((16#${red:2:2})) 'BEGIN { printf "%.3f", n / 255 }')
      b=$(awk -v n=$((16#${red:4:2})) 'BEGIN { printf "%.3f", n / 255 }')
      mkdir -p "$SUMI_DIR"
      sed -E "s/^const vec3 SEAL = .*/const vec3 SEAL = vec3($r, $g, $b);   \/\/ the theme's red (#$red)/" "$SRC/assets/shaders/sumi.glsl" > "$SUMI_DIR/sumi.glsl"
      if [[ ! -f $SUMI_DIR/dnd-before ]]; then
        omarchy-shell notifications isDnd 2>/dev/null > "$SUMI_DIR/dnd-before" || echo off > "$SUMI_DIR/dnd-before"
      fi
      omarchy-shell -q notifications setDnd true >/dev/null
      command -v hyprctl >/dev/null && hyprctl eval "hl.config({ decoration = { screen_shader = '$SUMI_DIR/sumi.glsl' } })" >/dev/null 2>&1 || true
      omarchy-shell -q hankowind setSumi true >/dev/null
      omarchy-shell -q hanko riding true >/dev/null
      omarchy-osd -i 墨 -m "Sumi · ink only" -d 1400 >/dev/null 2>&1 || true
      ;;
    off)
      sumi_on || { say "Sumi is off."; return; }
      rm -f "$SUMI_DIR/sumi.glsl"
      if [[ $(cat "$SUMI_DIR/dnd-before" 2>/dev/null) != on ]]; then omarchy-shell -q notifications setDnd false >/dev/null; fi
      rm -f "$SUMI_DIR/dnd-before"
      hypr_reload
      omarchy-shell -q hankowind setSumi false >/dev/null
      omarchy-shell -q hanko riding false >/dev/null
      omarchy-osd -i 墨 -m "Sumi off" -d 1000 >/dev/null 2>&1 || true
      ;;
    status) if sumi_on; then say on; else say off; fi ;;
    *) fail "usage: hanko sumi [on|off|status]" ;;
  esac
}

# Dōgu 道具, the tools (docs/kaze, mockup 12): btop and Neovim on the bar's
# paper and inks, from the current theme. Opt-in, like the prompt: `tools on`
# writes btop's hanko.theme (a theme-set hook rewrites it), points btop.conf's
# color_theme at it, and adds a LazyVim spec that loads colors/hanko.lua
# (which reads the theme itself, so Neovim follows a theme switch on its
# own). `tools off` puts btop's previous theme back and removes the spec.
BTOP_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/btop/btop.conf"
BTOP_THEME="${XDG_CONFIG_HOME:-$HOME/.config}/btop/themes/hanko.theme"
NVIM_SPEC="${XDG_CONFIG_HOME:-$HOME/.config}/nvim/lua/plugins/zz-hanko-kaze.lua"
TOOLS_HOOK="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/hooks/theme-set.d/51-hanko-tools"
tools_on() { [[ -f $NVIM_SPEC || -f $STATE/tools/btop-before ]]; }

# A Lua to run the generators with: lua, luajit, or Neovim's own.
lua_run() {
  local path="$SRC/assets/kaze/nvim/lua/?.lua;;"
  if command -v lua >/dev/null 2>&1; then LUA_PATH="$path" lua "$@"
  elif command -v luajit >/dev/null 2>&1; then LUA_PATH="$path" luajit "$@"
  elif command -v nvim >/dev/null 2>&1; then LUA_PATH="$path" nvim -l "$@"
  else fail "no Lua found (lua, luajit or nvim)"; fi
}
btop_write() {
  mkdir -p "$(dirname "$BTOP_THEME")"
  lua_run "$SRC/assets/kaze/btop.lua" > "$BTOP_THEME.tmp" && mv "$BTOP_THEME.tmp" "$BTOP_THEME"
}

cmd_tools() {
  case "${1:-status}" in
    on)
      btop_write
      if [[ -f $BTOP_CONF ]]; then
        mkdir -p "$STATE/tools"
        if [[ ! -f $STATE/tools/btop-before ]]; then
          sed -nE 's/^color_theme *= *"(.*)"/\1/p' "$BTOP_CONF" | head -1 > "$STATE/tools/btop-before"
        fi
        sed -i -E 's/^color_theme *=.*/color_theme = "hanko"/' "$BTOP_CONF"
      else
        mkdir -p "$STATE/tools" "$(dirname "$BTOP_CONF")"
        echo "" > "$STATE/tools/btop-before"
        printf 'color_theme = "hanko"\n' > "$BTOP_CONF"
      fi
      write_hook "$TOOLS_HOOK" "\"$SRC/scripts/hanko\" tools refresh >/dev/null 2>&1 || true"
      if [[ -d $(dirname "$NVIM_SPEC") ]]; then
        cat > "$NVIM_SPEC" <<LUA
-- Hanko 判子 · Kaze 風: Neovim on the bar's paper (hanko tools off removes this).
-- colors/hanko.lua reads the current Omarchy theme, so it follows a theme
-- switch; Omarchy's hot reload applies its own scheme first, then this one.
return {
  {
    name = "hanko-kaze",
    dir = "$SRC/assets/kaze/nvim",
    lazy = false,
    priority = 1001,
    config = function()
      vim.api.nvim_create_autocmd("User", {
        pattern = "LazyReload",
        callback = function() vim.defer_fn(function() pcall(vim.cmd.colorscheme, "hanko") end, 150) end,
      })
    end,
  },
  { "LazyVim/LazyVim", opts = { colorscheme = "hanko" } },
}
LUA
      else
        say "  (no ~/.config/nvim/lua/plugins: Neovim left alone; :colorscheme hanko works with $SRC/assets/kaze/nvim on the runtimepath)"
      fi
      say "Tools on: btop and Neovim in your theme's inks (restart btop and Neovim to see them)."
      ;;
    refresh) [[ -f $BTOP_THEME ]] && btop_write ;;
    off)
      tools_on || { say "Tools are off."; return; }
      if [[ -f $STATE/tools/btop-before && -f $BTOP_CONF ]]; then
        local before; before="$(cat "$STATE/tools/btop-before")"
        sed -i -E "s/^color_theme *=.*/color_theme = \"${before:-current}\"/" "$BTOP_CONF"
      fi
      rm -f "$STATE/tools/btop-before" "$BTOP_THEME" "$NVIM_SPEC" "$TOOLS_HOOK"
      say "Tools off: btop and Neovim are back on Omarchy's theme."
      ;;
    status) if tools_on; then say on; else say off; fi ;;
    *) fail "usage: hanko tools on|off|status" ;;
  esac
}

# The Hanko theme lives in the repo as theme/ (colours, Hyprland, the
# menu, launcher and bar, btop, Neovim, the prints). `theme install` links it
# into Omarchy's user themes; a link to your own copy is staged whole (a
# theme cloned from git may not ship Lua), and Omarchy's templates fill in
# the terminals. `omarchy theme set hanko` then brings the whole set.
# Omarchy looks in $HOME/.config (not XDG_CONFIG_HOME) for user themes.
THEME_LINK="$HOME/.config/omarchy/themes/hanko"
THEME_NAME_FILE="$HOME/.local/state/omarchy/current/theme.name"
THEME_BEFORE="$STATE/theme-before"
cmd_theme() {
  case "${1:-status}" in
    install)
      if [[ -e $THEME_LINK && ! -L $THEME_LINK ]]; then fail "$THEME_LINK exists and is not Hanko's link; move it away first"; fi
      mkdir -p "$(dirname "$THEME_LINK")"
      ln -sfn "$SRC/theme" "$THEME_LINK"
      say "The Hanko theme is installed: omarchy theme set hanko"
      ;;
    remove)
      [[ -L $THEME_LINK ]] || { say "The Hanko theme is not installed."; return; }
      if [[ $(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null) == hanko ]]; then
        say "  (Hanko is the theme in use; it stays until you pick another)"
      fi
      rm "$THEME_LINK"
      say "The Hanko theme is removed."
      ;;
    # On: installed and in use, the theme it replaced kept to go back to.
    on)
      local now
      now="$(cat "$THEME_NAME_FILE" 2>/dev/null || true)"
      [[ -L $THEME_LINK ]] || cmd_theme install >/dev/null
      if [[ $now != hanko ]]; then
        mkdir -p "$STATE"
        [[ -n $now ]] && printf '%s\n' "$now" > "$THEME_BEFORE"
        need omarchy
        omarchy theme set hanko >/dev/null || fail "omarchy theme set hanko failed"
      fi
      say "The Hanko theme is on (hanko theme off goes back to ${now:-your last theme})."
      ;;
    # Off: back to the theme Hanko replaced, or, without one, the first other.
    off)
      local back
      [[ $(cat "$THEME_NAME_FILE" 2>/dev/null) == hanko ]] || { say "The Hanko theme is not in use."; return; }
      need omarchy
      back="$(cat "$THEME_BEFORE" 2>/dev/null || true)"
      [[ -n $back && $back != hanko ]] || back="$(omarchy theme list | grep -vix hanko | head -1)"
      [[ -n $back ]] || fail "no other theme to go back to"
      omarchy theme set "$back" >/dev/null || fail "omarchy theme set $back failed"
      rm -f "$THEME_BEFORE"
      say "Back to $back."
      ;;
    status) if [[ $(cat "$THEME_NAME_FILE" 2>/dev/null) == hanko ]]; then say on; elif [[ -L $THEME_LINK ]]; then say installed; else say "not installed"; fi ;;
    *) fail "usage: hanko theme on|off|install|remove|status" ;;
  esac
}

# Ōin 押印, the boot screen (docs/kaze §4.1): a Plymouth theme, "hanko",
# drawn by scripts/hanko-boot for the current theme and installed beside
# Omarchy's in /usr/share/plymouth/themes. On sets it as Plymouth's theme and
# rebuilds the initramfs (as Omarchy's own `omarchy plymouth set` does); off
# puts back the theme it replaced (Omarchy's, unless you had another) and
# rebuilds again. Both need root once: sudo in a terminal, else pkexec.
#
# Before anything is installed, the theme is played through
# assets/boot/sim.mjs (Plymouth's script language, interpreted, with every
# path a boot takes); a theme that errors there is never installed. If a
# boot ever shows nothing, the passphrase still works typed blind, and Esc
# shows Plymouth's text prompt.
BOOT_BEFORE="$STATE/boot-before"
# What the installed screen was drawn for (Settings › Boot says when the
# theme, the seal or a choice has changed since).
BOOT_DRAWN="$STATE/boot-drawn.json"
boot_drawn() {
  local kaze="${XDG_CONFIG_HOME:-$HOME/.config}/hanko/kaze.json" style="${XDG_CONFIG_HOME:-$HOME/.config}/hanko/style.json" glyph
  glyph="$(jq -r '.sealGlyph // "鑑"' "$style" 2>/dev/null || echo 鑑)"
  [[ -n $glyph && $glyph != null ]] || glyph="鑑"
  jq -n --arg theme "$(cat "$THEME_NAME_FILE" 2>/dev/null || true)" --arg glyph "${glyph:0:1}" \
    --arg name "$(jq -r 'if .bootName == "none" then "none" else "name" end' "$kaze" 2>/dev/null || echo name)" \
    --arg press "$(jq -r 'if .bootPress == "still" then "still" else "ink" end' "$kaze" 2>/dev/null || echo ink)" \
    --arg mark "$(jq -r 'if .bootMark == "brush" then "brush" else "seal" end' "$kaze" 2>/dev/null || echo seal)" \
    --arg at "$(date -Iseconds)" '{ theme: $theme, glyph: $glyph, name: $name, press: $press, mark: $mark, at: $at }' > "$BOOT_DRAWN"
}
BOOT_THEMES=/usr/share/plymouth/themes
boot_theme() { plymouth-set-default-theme 2>/dev/null || sed -nE 's/^ *Theme *= *//p' /etc/plymouth/plymouthd.conf 2>/dev/null | head -1; }
boot_on() { [[ $(boot_theme) == hanko ]]; }

as_root() {
  if (( EUID == 0 )); then "$@"
  elif [[ -t 0 ]] && command -v sudo >/dev/null; then sudo "$@"
  elif command -v pkexec >/dev/null; then pkexec "$@"
  else fail "this needs root, and neither sudo (in a terminal) nor pkexec is here"; fi
}

# The privileged part, in one go: install (or remove) the theme, set
# Plymouth's theme, rebuild the initramfs; on a failed rebuild, go back to
# the theme before and rebuild that.
# shellcheck disable=SC2016
BOOT_ROOT='
set -euo pipefail
PATH=/usr/bin:/bin
action=$1 stage=$2 theme=$3 themes=/usr/share/plymouth/themes
rebuild() {
  if command -v limine-mkinitcpio >/dev/null; then limine-mkinitcpio; else mkinitcpio -P; fi
}
if [[ $action == on ]]; then
  [[ -d $stage && ! -L $stage && -f $stage/hanko.plymouth && -f $stage/hanko.script ]] || { echo "no theme to install" >&2; exit 1; }
  for f in "$stage"/*; do
    n=${f##*/}
    [[ -f $f && ! -L $f ]] || { echo "refusing $n" >&2; exit 1; }
    [[ $n == hanko.plymouth || $n == hanko.script || $n =~ ^[a-z0-9-]+\.png$ ]] || { echo "refusing $n" >&2; exit 1; }
  done
  rm -rf "$themes/.hanko.new"
  install -d -m 0755 "$themes/.hanko.new"
  install -m 0644 "$stage"/* "$themes/.hanko.new/"
  rm -rf "$themes/hanko"
  mv "$themes/.hanko.new" "$themes/hanko"
fi
[[ -f $themes/$theme/$theme.plymouth ]] || { echo "no Plymouth theme $theme" >&2; exit 1; }
before=$(plymouth-set-default-theme)
plymouth-set-default-theme "$theme"
if ! rebuild; then
  echo "the initramfs did not rebuild; going back to $before" >&2
  plymouth-set-default-theme "$before"
  rebuild || true
  exit 1
fi
[[ $action == off ]] && rm -rf "$themes/hanko"
exit 0
'

cmd_boot() {
  case "${1:-status}" in
    on|refresh)
      [[ ${1} == refresh ]] && ! boot_on && { say "The Hanko boot screen is off (hanko boot on)."; return; }
      need plymouth-set-default-theme
      local stage now
      stage="$(mktemp -d "${TMPDIR:-/tmp}/hanko-boot-stage.XXXXXX")"
      trap 'rm -rf "$stage"' RETURN
      "$SRC/scripts/hanko-boot" build "$stage" || fail "the boot screen didn't draw"
      if command -v node >/dev/null; then
        node "$SRC/assets/boot/sim.mjs" --check "$stage" >/dev/null || fail "the boot screen failed its check; nothing was installed"
      else
        say "node isn't installed, so the boot screen's script wasn't checked before installing."
      fi
      now="$(boot_theme)"
      if [[ $now != hanko ]]; then mkdir -p "$STATE"; printf '%s\n' "${now:-omarchy}" > "$BOOT_BEFORE"; fi
      say "Installing the boot screen and rebuilding the initramfs (this takes a minute)…"
      as_root /bin/bash -c "$BOOT_ROOT" bash on "$stage" hanko || fail "the boot screen wasn't set (your boot is as it was)"
      mkdir -p "$STATE"; boot_drawn
      say "The Hanko boot screen is on from the next boot (hanko boot off goes back to ${now:-omarchy})."
      ;;
    off)
      boot_on || { say "The Hanko boot screen is off."; return; }
      local back
      back="$(cat "$BOOT_BEFORE" 2>/dev/null || true)"
      [[ -n $back && $back != hanko && -f $BOOT_THEMES/$back/$back.plymouth ]] || back=omarchy
      say "Putting back $back and rebuilding the initramfs…"
      as_root /bin/bash -c "$BOOT_ROOT" bash off "" "$back" || fail "the boot screen wasn't changed"
      rm -f "$BOOT_BEFORE" "$BOOT_DRAWN"
      say "Back to the $back boot screen from the next boot."
      ;;
    preview)
      local out="${2:-$STATE/boot-preview.png}"
      mkdir -p "$(dirname "$out")"
      "$SRC/scripts/hanko-boot" preview "$out" >/dev/null || fail "the preview didn't draw"
      if [[ -z ${2:-} ]] && command -v imv >/dev/null && [[ -n ${WAYLAND_DISPLAY:-} ]]; then imv "$out" & disown; fi
      say "$out"
      ;;
    status) if boot_on; then say on; else say "off ($(boot_theme))"; fi ;;
    *) fail "usage: hanko boot on|off|refresh|preview [OUT]|status" ;;
  esac
}

# Dōgu 道具: the brush-tip cursor. scripts/hanko-cursor builds Hanko-Brush for
# the current theme into ~/.local/share/icons; the flag file holds its size,
# style.lua re-applies it after your own autostart on every reload, and the
# theme-set hook rebuilds it in the new theme's ink. `off` deletes the flag
# and reloads Hyprland, so your autostart's cursor comes back.
CURSOR_FLAG="$STATE/cursor"
CURSOR_SIZE_MIN=16; CURSOR_SIZE_MAX=48
# The size the cursor is (or was last) worn at: the flag's, else your own.
cursor_size() {
  local n; n="$(grep -m1 -oE '[0-9]+' "$CURSOR_FLAG" 2>/dev/null || true)"
  printf '%s\n' "${n:-${HYPRCURSOR_SIZE:-${XCURSOR_SIZE:-22}}}"
}
cmd_cursor() {
  local want="${1:-toggle}" size
  [[ $want == toggle ]] && { [[ -f $CURSOR_FLAG ]] && want=off || want=on; }
  case "$want" in
    on)
      size="${2:-$(cursor_size)}"
      [[ $size =~ ^[0-9]+$ ]] && (( size >= CURSOR_SIZE_MIN && size <= CURSOR_SIZE_MAX )) \
        || fail "the cursor's size is $CURSOR_SIZE_MIN to $CURSOR_SIZE_MAX pixels"
      "$SRC/scripts/hanko-cursor" >/dev/null || fail "the cursor didn't build"
      mkdir -p "$STATE"; printf '%s\n' "$size" > "$CURSOR_FLAG"
      command -v hyprctl >/dev/null && hyprctl setcursor Hanko-Brush "$size" >/dev/null 2>&1 || true
      say "The brush-tip cursor is on at $size px (hanko cursor off puts yours back)."
      ;;
    size)
      size="${2:-}"
      [[ -n $size ]] || { cursor_size; return; }
      [[ $size =~ ^[0-9]+$ ]] && (( size >= CURSOR_SIZE_MIN && size <= CURSOR_SIZE_MAX )) \
        || fail "the cursor's size is $CURSOR_SIZE_MIN to $CURSOR_SIZE_MAX pixels"
      # Already built: only the size changes, no rebuild.
      if [[ -f $CURSOR_FLAG && -d ${XDG_DATA_HOME:-$HOME/.local/share}/icons/Hanko-Brush ]]; then
        printf '%s\n' "$size" > "$CURSOR_FLAG"
        command -v hyprctl >/dev/null && hyprctl setcursor Hanko-Brush "$size" >/dev/null 2>&1 || true
        say "The brush-tip cursor is $size px."
      else
        cmd_cursor on "$size"
      fi
      ;;
    off)
      [[ -f $CURSOR_FLAG ]] || { say "The brush-tip cursor is off."; return; }
      rm -f "$CURSOR_FLAG"
      hypr_reload
      say "Your own cursor is back."
      ;;
    status) if [[ -f $CURSOR_FLAG ]]; then say on; else say off; fi ;;
    *) fail "usage: hanko cursor [on [SIZE]|off|size [SIZE]|status]" ;;
  esac
}

cmd_doctor() {
  local ok=1
  check() { if eval "$2" >/dev/null 2>&1; then say "  ok    $1"; else say "  FAIL  $1"; ok=0; fi; }
  say "Hanko doctor"
  check "omarchy is installed" "command -v omarchy"
  check "the Omarchy shell is running" "shell_up"
  check "manifest validates" "omarchy plugin validate '$SRC'"
  check "Hanko is in the plugins folder" "[[ -e '$DEST' ]]"
  check "Hanko is the active bar" "[[ \$(active_bar) == '$ID' ]]"
  check "Noto CJK fonts for the kanji" "fc-list -q 'Noto Sans CJK JP'"
  check "jq is installed" "command -v jq"
  if desk_on; then say "  ok    Kaze is on"; else say "  --    Kaze is off (hanko desk on)"; fi
  if style_loaded; then say "  ok    style.lua loads from looknfeel.lua"; else say "  --    style.lua isn't loaded (add: $LOOK_LINE)"; fi
  # Each of the desk's surfaces: installed, and answering its IPC call.
  local id
  for id in "${SURFACES[@]}"; do
    if [[ ! -d $PLUGINS/$id ]]; then desk_on && say "  FAIL  $id is not installed (hanko desk on)" && ok=0; continue; fi
    if ! shell_up; then say "  --    $id is installed (the shell is not running)"; continue; fi
    if [[ -n $(surface_probe "$id" 2>/dev/null | grep -v '^Target not found') ]]; then say "  ok    $id answers"
    else say "  FAIL  $id is installed but does not answer (Omarchy's own may be missing; hanko desk on retries)"; ok=0; fi
  done
  if sumi_on; then say "  --    Sumi is on (hanko sumi off)"; fi
  if boot_on; then check "Boot: the hanko Plymouth theme is installed" "[[ -f $BOOT_THEMES/hanko/hanko.script ]]"; fi
  if tools_on; then check "Tools: btop's hanko theme is written" "[[ -s '$BTOP_THEME' ]]"; fi
  if shell_up; then
    local w
    w="$(omarchy-shell hanko warnings 2>/dev/null || true)"
    if [[ -n $w ]]; then say "  style.json warnings:"; printf '    %s\n' "$w"; fi
  fi
  (( ok )) || exit 1
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  dev) shift; cmd_dev "$@" ;;
  uninstall) cmd_uninstall ;;
  style) shift; cmd_style "$@" ;;
  settings) ipc settings >/dev/null ;;
  hide|show)
    (( $# == 2 )) || fail "usage: hanko $1 <part> (see the Widgets page in hanko settings)"
    [[ $(ipc "$1" "$2") == ok ]] || fail "'$2' is not a part Hanko knows" ;;
  press) ipc press >/dev/null ;;
  inkan)
    case "${2:-}" in
      on) form=inkan ;;
      off) form=bar ;;
      "") [[ $(ipc styleGet | jq -r .form) == inkan ]] && form=bar || form=inkan ;;
      *) fail "usage: hanko inkan [on|off]" ;;
    esac
    [[ $(ipc styleSet form "$form") == ok ]] || fail "could not set form $form"
    say "form: $form" ;;
  menu) shift; cmd_menu "$@" ;;
  desk) shift; cmd_desk "$@" ;;
  sumi) shift; cmd_sumi "$@" ;;
  cursor) shift; cmd_cursor "$@" ;;
  tools) shift; cmd_tools "$@" ;;
  theme) shift; cmd_theme "$@" ;;
  boot) shift; cmd_boot "$@" ;;
  doctor) cmd_doctor ;;
  -h|--help|"") awk 'NR > 1 && !/^#/ { exit } NR > 1' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
  *) fail "unknown command '$1' (try hanko --help)" ;;
esac
